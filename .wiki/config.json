{
  "version": 3,
  "note": "分区与类型全中文；自定义用命令最方便：wiki.py layer add / type add。改阈值等低频项才手改本文件（改完跑 init + index）",
  "layers": {
    "通用": {
      "path": "通用",
      "prefix": "TEC",
      "title": "通用技术",
      "note": "跨项目都适用的技术知识"
    },
    "基础设施": {
      "path": "基础设施",
      "prefix": "INF",
      "title": "基础设施·杂项",
      "note": "不好归类的基础设施条目"
    },
    "基础设施/数据库": {
      "path": "基础设施/数据库",
      "prefix": "DB",
      "title": "基础设施·数据库"
    },
    "基础设施/k8s": {
      "path": "基础设施/k8s",
      "prefix": "K8",
      "title": "基础设施·K8s/容器"
    },
    "基础设施/网络": {
      "path": "基础设施/网络",
      "prefix": "NET",
      "title": "基础设施·网络与证书"
    },
    "基础设施/存储": {
      "path": "基础设施/存储",
      "prefix": "STO",
      "title": "基础设施·存储与镜像仓"
    },
    "基础设施/发布": {
      "path": "基础设施/发布",
      "prefix": "CID",
      "title": "基础设施·部署与CI/CD"
    },
    "基础设施/资产": {
      "path": "基础设施/资产",
      "prefix": "AST",
      "title": "基础设施·资产登记",
      "note": "虚机/集群清单、常用链接等 registry 类"
    },
    "项目": {
      "path": "项目",
      "prefix": "PRJ",
      "title": "项目知识",
      "note": "一项目一子目录，README 当项目画像；递归扫描零配置"
    }
  },
  "types": {
    "现状": {
      "title": "现状",
      "desc": "事实/拓扑/资产现状，只写\"是什么\""
    },
    "决策": {
      "title": "决策",
      "desc": "选型与架构决策（ADR 即此类），必须带备选对比"
    },
    "规范": {
      "title": "规范",
      "desc": "要求或禁止的行为，必须带理由"
    },
    "踩坑": {
      "title": "踩坑",
      "desc": "踩过的坑，原因已查明"
    },
    "流程": {
      "title": "流程",
      "desc": "步骤确定的人工流程"
    },
    "手册": {
      "title": "手册",
      "desc": "Agent 可辅助执行的运维手册(runbook)，必须带 risk/回滚/验证"
    }
  },
  "maturity": {
    "levels": ["draft", "verified", "proven"],
    "promote": {
      "draft_to_verified": {
        "validations": 1
      },
      "verified_to_proven": {
        "distinct_validators": 2,
        "distinct_projects": 2,
        "requires_maintainer": true
      }
    },
    "decay": {
      "proven_months": 12,
      "verified_months": 6,
      "archive_draft_months": 6,
      "evergreen_exempt": true
    }
  },
  "query_budgets": {
    "default": {
      "layerB_dirs": 2,
      "full_entries": 5,
      "hint": "默认预算"
    },
    "troubleshoot": {
      "layerB_dirs": 2,
      "full_entries": 3,
      "hint": "排障：优先 踩坑→手册，再查现状"
    },
    "implement": {
      "layerB_dirs": 2,
      "full_entries": 4,
      "hint": "开发：先查规范，再查同类踩坑"
    },
    "ops_execute": {
      "layerB_dirs": 1,
      "full_entries": 1,
      "hint": "执行手册：目标手册必须完整读，risk=high 必须人工确认"
    }
  },
  "lint": {
    "runbook_requires": ["前置检查", "验证", "回滚"],
    "guideline_polarity_values": ["recommend", "avoid"],
    "duplicate_title_jaccard": 0.6
  },
  "paths": {
    "catalog": "catalog.md",
    "log": ".wiki/logs",
    "pending": "pending",
    "archive": "archive",
    "templates": ".wiki/templates"
  }
}
